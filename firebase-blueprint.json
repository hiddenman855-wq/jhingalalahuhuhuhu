{
  "entities": {
    "Website": {
      "title": "Website",
      "description": "A curated directory listing",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "url": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 500 },
        "longDescription": { "type": "string", "maxLength": 5000 },
        "categoryId": { "type": "string", "maxLength": 100 },
        "tags": { "type": "array" },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "featured": { "type": "boolean" },
        "featuredOrder": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "draft", "disabled"] },
        "displayOrder": { "type": "number" },
        "clickCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastCheckedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "url", "description", "categoryId", "status", "createdAt", "updatedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Category for organizing websites",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string", "maxLength": 50 },
        "displayOrder": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "displayOrder", "active", "createdAt", "updatedAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "User suggested website submission",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "url": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 500 },
        "categoryId": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "submittedAt": { "type": "string", "format": "date-time" },
        "reviewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "url", "description", "status", "submittedAt"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global directory configuration",
      "type": "object",
      "properties": {
        "directoryName": { "type": "string", "maxLength": 100 },
        "directoryDescription": { "type": "string", "maxLength": 500 },
        "logo": { "type": "string", "maxLength": 500 },
        "contactEmail": { "type": "string", "maxLength": 150 },
        "seoTitle": { "type": "string", "maxLength": 150 },
        "seoDescription": { "type": "string", "maxLength": 500 },
        "socialImage": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["directoryName", "updatedAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail of admin operations",
      "type": "object",
      "properties": {
        "action": { "type": "string", "maxLength": 100 },
        "entityType": { "type": "string", "maxLength": 50 },
        "entityId": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "adminId": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "entityType", "description", "createdAt"]
    }
  },
  "firestore": {
    "/websites/{websiteId}": {
      "schema": { "$ref": "#/entities/Website" },
      "description": "Collection of directory listings"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Collection of directory categories"
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Collection of user submitted websites"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Directory site configuration"
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Audit activity logs of changes"
    }
  }
}
